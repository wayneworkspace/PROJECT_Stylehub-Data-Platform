# SQL style and syntax check for the dbt models (run: uv run sqlfluff lint dbt).
# It does not connect to BigQuery. The templater only needs to turn {{ ref() }}, {{ source() }} and
# {{ config() }} into plain SQL, so sqlfluff_macros/ gives it simple stand-ins for them.
[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 100
# Rules that only argue about taste. Everything else stays on.
# layout.select_targets and structure.using: the models use another, equally readable layout
# (short selects on one line, USING in joins). Indentation and the blank line between CTEs are checked.
exclude_rules = ambiguous.column_count, structure.column_order, convention.terminator, layout.select_targets, structure.using

[sqlfluff:templater:jinja]
load_macros_from_path = sqlfluff_macros
apply_dbt_builtins = False

[sqlfluff:templater:jinja:context]
execute = False
this = my_table

[sqlfluff:indentation]
tab_space_size = 2

# No subqueries anywhere (the project rule: CTEs only). Default is to check JOINs only.
[sqlfluff:rules:structure.subquery]
forbid_subquery_in = both

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
