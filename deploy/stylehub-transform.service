[Unit]
Description=StyleHub pipeline: Load Bronze, build Silver and Gold, run checks
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/stylehub/deploy/run_pipeline.sh bronze checks /etc/stylehub/transform-sa.json
# Logs go to journald. Read them with: journalctl -u stylehub-transform
