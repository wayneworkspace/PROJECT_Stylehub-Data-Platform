# GCP
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=asia-southeast1   # region of the bucket and datasets
# Prefer `gcloud auth application-default login`; use a key only for Docker.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json   # relative to the project folder

# GCS
GCS_BUCKET=your-bucket-name
RAW_PREFIX=raw/stylehub

# BigQuery datasets
BQ_SOURCE=stylehub          # course source tables
BQ_BRONZE=stylehub_bronze
BQ_STAGING=stylehub_staging   # still holds personal data; keep analysts out
BQ_SILVER=stylehub_silver
BQ_GOLD=stylehub_gold

# Operations
BQ_OPS=stylehub_ops          # holds pipeline_runs
BQ_MAX_BYTES_BILLED=50000000000   # max bytes one query may bill (50 GB)

# Course Postgres source (read-only account); never commit the real URL.
POSTGRES_URL=postgresql+psycopg2://user:password@host:5432/stylehub?sslmode=require

# Airflow in local Docker only; never reuse real passwords here.
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Long random text: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=
# Fernet key: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Local port of the Airflow web page.
AIRFLOW_WEB_PORT=8080

# TypeSafe (Jev) key for include/scripts/jev_review.py; review only, never in the pipeline.
AI_GATEWAY_API_KEY=your-typesafe-api-key
