# GCP
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=asia-southeast1   # where setup.setup_gcp creates the bucket and datasets
# No key file needed on your laptop: run `gcloud auth application-default login` once (a key file
# is a long-lived password; a leaked one is a real incident). Use a key only when you must, for
# example Airflow in Docker on a laptop, and then uncomment the next line. On a GCP VM leave it out.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json   # counted from the project folder

# GCS
GCS_BUCKET=your-bucket-name
RAW_PREFIX=raw/stylehub

# BigQuery datasets
BQ_SOURCE=stylehub          # dataset holding the course's original tables (events, ...)
BQ_BRONZE=stylehub_bronze
BQ_STAGING=stylehub_staging   # views over Bronze that still hold email and location: keep analysts out
BQ_SILVER=stylehub_silver
BQ_GOLD=stylehub_gold

# Operations
BQ_OPS=stylehub_ops          # dataset for the pipeline_runs table
BQ_MAX_BYTES_BILLED=50000000000   # BigQuery refuses a query that would bill more bytes (50 GB)
# DBT_DEV_USER=quang         # your name: a dbt run by hand writes to dbt_<name>_stylehub_silver, not to the real datasets

# Airflow (optional: only for `docker compose --profile airflow`). Local use only. Never reuse a real password here.
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Any long random text. It is also the token secret between the Airflow API server and the scheduler. Make one with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=
# Encrypts what Airflow stores. 32 random bytes, url-safe base64. Make one with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Port of the Airflow web page (API server) on your computer. Change it if 8080 is already used.
AIRFLOW_WEB_PORT=8080
