# GCP
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=asia-southeast1   # where storage.setup.setup_gcp creates the bucket and datasets
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json   # counted from the project folder

# GCS
GCS_BUCKET=your-bucket-name
RAW_PREFIX=raw/stylehub

# BigQuery datasets
BQ_SOURCE=stylehub          # dataset holding the course's original tables (events, ...)
BQ_BRONZE=stylehub_bronze
BQ_SILVER=stylehub_silver
BQ_GOLD=stylehub_gold

# Postgres source (optional: only for ingestion.optional.database; the main flow reads the course CSV tables)
PG_HOST=
PG_PORT=5432
PG_SSLMODE=require   # the course server needs TLS. Use prefer for a local Docker Postgres
PG_DATABASE=
PG_USER=student_readonly
PG_PASSWORD=

# StyleHub API (optional: only for ingestion.optional.api)
API_URL=            # base URL, for example https://<project>.supabase.co/functions/v1
API_KEY=            # the key from the StyleHub API Reference. Never commit it.
API_KEY_HEADER=x-api-key   # header that carries the key. Check the API Reference

# Operations
BQ_OPS=stylehub_ops          # dataset for the pipeline_runs table
ALERT_WEBHOOK_URL=           # optional Discord webhook. Leave empty to turn alerts off

# Airflow (optional: only for `docker compose --profile airflow`). Local use only. Never reuse a real password here.
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Any long random text. Make one with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=
# Port of the web page on your computer. Change it if 8080 is already used.
AIRFLOW_WEB_PORT=8080
