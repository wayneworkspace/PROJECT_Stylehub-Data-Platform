# Terraform: local state holds resource ids and can hold secrets. Never commit it.
.terraform/
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars
*.auto.tfvars
# The lock file IS committed: it pins the provider version.
!.terraform.lock.hcl
